{
  "name": "sistema-sales",
  "private": true,
  "version": "0.0.0",
  "description": "Sistema de Gestión de Ventas y Abastecimiento",
  "author": {
    "name": "SISTEMA SALES",
    "email": "contacto@sistemasales.com"
  },
  "homepage": "https://sistemasales.com",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "package": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.sistemasales.app",
    "productName": "SISTEMA_SALES",
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "win": {
      "target": "nsis"
    },
    "npmRebuild": true,
    "buildDependenciesFromSource": true
  },
  "dependencies": {
    "@mermaid-js/mermaid-cli": "^11.17.0",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "main": "dist-electron/main.js"
}
